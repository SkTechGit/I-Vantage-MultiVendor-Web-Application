# =========================================================================
# i-VANTAGE Enterprise Gitignore & Security Boundary Protection
# =========================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment & Secret Credential Files (STRICT PROTECTION)
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
server/.env
client/.env.local
*.env
*.env.json
ENV_CREDENTIALS*
secrets*
passwords*
credentials*.json
client_secret*.json
service-account*.json
service_account*.json
!.env.example

# Private Keys, Certificates & Authentication Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
id_rsa*
id_ed25519*
*.keystore

# Database Dumps, Backups & Local Data Stores
*.sql
*.dump
*.sqlite
*.sqlite3
dump/
data/

# Build Outputs & Framework Artifacts
.next/
client/.next/
out/
build/
dist/
.cache/
.parcel-cache/
.turbo/
.vercel

# Binaries & Executables
*.exe
cloudflared.exe
client/cloudflared.exe

# Application, Server & Package Manager Logs
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Office, Binary Documents & Data Exports (Only README.md allowed)
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.csv
master-doc.html
generate-master-doc.js
server/scripts/generate-master-doc.js
server/scripts/master-doc.html
docs/
*.md
!README.md
!client/README.md

# Testing, Scratch & Temporary Generator Files
test.html
*.test.html
test/
tests/
test-*.js
test-*.ts
*.test.js
*.test.ts
generate_blog_calendar.py
scratch/

# IDE, Editor & OS Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo
next-env.d.ts
